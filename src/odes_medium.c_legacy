   * of the abundances of all ionized species in the chemical network */
  x_e = x[1]+x[4]+x[5]+x[7]+x[8]+x[10]+x[11]+x[12]+x[13]+x[16]+x[18]+x[20]+x[21]+x[22]+x[23]+x[24]+x[25]+x[28]+x[29]+x[30]+x[31]+x[32]+x[34]+x[35]+x[36]+x[37]+x[40]+x[41]+x[42]+x[43]+x[44]+x[47]+x[48]+x[49]+x[52]+x[53]+x[55]+x[58]+x[59]+x[60]+x[61]+x[70];

